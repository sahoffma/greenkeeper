# Supabase – Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api
# Für lokale Entwicklung nach .env.local kopieren (wird von Git ignoriert).

VITE_SUPABASE_URL=https://keoxzyzdkvebedgdswah.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Netlify Functions – nur serverseitig, niemals mit VITE_ prefix
OPENAI_API_KEY=

# Supabase Service Role – nur serverseitig (Netlify Functions), niemals VITE_
# Project Settings → API → service_role key
SUPABASE_URL=https://keoxzyzdkvebedgdswah.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Governance Admin – UUID eines Admin/Reviewer-Profils für Seed-Imports
GOVERNANCE_ADMIN_USER_ID=

# Produkt-Assistent: true = keine OpenAI-Bildanalyse, nur manuelle Basisdaten
PRODUCT_ASSISTANT_DEV_MODE=false
