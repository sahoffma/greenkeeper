# Supabase – Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api
# Für lokale Entwicklung nach .env.local kopieren (wird von Git ignoriert).
#
# WICHTIG: Lokale Entwicklung nutzt ausschließlich das DEV-Projekt.
# Production-Project-Ref (gesperrt für Schreibtests): keoxzyzdkvebedgdswah

VITE_SUPABASE_URL=https://YOUR-DEV-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-dev-anon-key

# Netlify Functions – nur serverseitig, niemals mit VITE_ prefix
OPENAI_API_KEY=

# Supabase Service Role – nur serverseitig (Netlify Functions / Testskripte), niemals VITE_
SUPABASE_URL=https://YOUR-DEV-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direkte DB-Migration via Skript (nur Dev, niemals Production)
# SUPABASE_DB_PASSWORD=
# SUPABASE_ACCESS_TOKEN=

# Freigabe für schreibende Supabase-Testskripte (nur Dev, niemals Production)
# ALLOW_SUPABASE_WRITE_TESTS=true

# Governance Admin – UUID eines Admin/Reviewer-Profils für Seed-Imports
GOVERNANCE_ADMIN_USER_ID=

# Produkt-Assistent: true = keine OpenAI-Bildanalyse, nur manuelle Basisdaten
PRODUCT_ASSISTANT_DEV_MODE=false
